#!/usr/bin/env python3
"""
Compatibility launcher for meshbot -> meshhub.
Invokes bin/meshhub while preserving all CLI arguments and behavior.
"""
import os
import sys

script_dir = os.path.dirname(os.path.abspath(__file__))
meshhub_script = os.path.join(script_dir, "meshhub")

if not os.path.exists(meshhub_script):
    print(f"Error: Could not locate {meshhub_script}", file=sys.stderr)
    sys.exit(1)

with open(meshhub_script, "rb") as f:
    code = compile(f.read(), meshhub_script, "exec")
    exec(code, globals())
