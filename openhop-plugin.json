{
  "schema": 1,
  "id": "openhop.meshhub-bot",
  "name": "MeshHub Bot",
  "version": "1.0.6",
  "description": "Bot & Community Automation Suite for openHop Repeater: !help, NWS weather alerts, radio net controller, MeshWars, and keyword auto-responder.",
  "profile": "python-service-v1",
  "runtime": {
    "type": "python",
    "entrypoint": "openhop-meshhub-bot"
  },
  "service": {
    "console_script": "openhop-meshhub-bot",
    "package_root": "openhop_meshhub_bot",
    "module": "openhop_meshhub_bot.main",
    "callable": "main"
  },
  "ui": {
    "type": "application",
    "entry": "ui/index.html"
  },
  "config": {
    "defaults": {
      "connection": {
        "host": "127.0.0.1",
        "tcpPort": 5000
      },
      "core": {
        "ipcPort": 5002,
        "perUserRateLimitSeconds": 30.0
      },
      "modules": {
        "autoresponce": {
          "enabled": true,
          "channels": [
            "#test"
          ],
          "responseTemplate": "@[{sender}] ACK | Path: {hops_label}",
          "maxHops": 15
        },
        "weather_bot": {
          "enabled": true,
          "channel": "#weather",
          "cron": "0 7 * * *",
          "latitude": 30.2672,
          "longitude": -97.7431,
          "nws_alerts": true
        },
        "net_bot": {
          "enabled": true,
          "channel": "#net",
          "day_of_week": "Tuesday",
          "time": "19:00",
          "duration": 2,
          "keyword": "#checkin",
          "state_file": "net_state.json"
        },
        "meshwars_bot": {
          "enabled": false,
          "channel": "#meshwars",
          "day_of_week": "Saturday",
          "time": "18:00",
          "duration": 6,
          "checkin_keyword": "!checkin",
          "state_file": "meshwars_state.json"
        }
      }
    }
  }
}
